// Cloudflare Workers (Static Assets) deployment config -- migrated from
// Netlify. "name" matches package.json's own "name" and this repo's name
// (monark-site), so it was left as-is rather than adjusted for a conflict;
// none was found.
{
  "name": "monark-site",
  "compatibility_date": "2026-07-24",
  // src/worker.js -- near-match URL redirect logic (typos/punctuation/
  // accents in an unknown path get 301/302'd to the closest known route).
  // Bundled by Wrangler separately from the assets.directory below (Worker
  // code vs. static files are two different deployment artifacts); see
  // that file's own header comment and scripts/build.js's
  // buildRoutesManifest() for where its route list comes from.
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    // Required once a `main` Worker exists -- without an explicit binding
    // name, the Worker would have no way to reach the static assets at all
    // (no implicit env.ASSETS). Also what makes Cloudflare's default
    // routing (assets.run_worker_first left unset, i.e. false) serve any
    // request that matches a real file in dist/ directly, WITHOUT ever
    // invoking src/worker.js -- that Worker only runs for requests that
    // already missed every static asset, which is exactly what its own
    // near-match logic needs (see that file's header comment) and means
    // this change can't affect any already-working page/asset request.
    "binding": "ASSETS",
    // "none", NOT "404-page" -- this is the one line that actually controls
    // whether an unmatched request reaches src/worker.js at all.
    // "404-page"/"single-page-application" make Cloudflare's OWN asset
    // layer handle a non-matching path directly (serving the configured
    // page) WITHOUT ever invoking the Worker -- confirmed live: with
    // "404-page" set, /prduit (a near-miss this Worker is supposed to
    // 302-redirect) served the plain 404 page straight from the asset
    // layer, src/worker.js never ran. "none" is the one value that defers
    // a non-match to the Worker's own fetch() handler instead, which is
    // required for near-match redirects to ever run at all. Real
    // pages/assets are unaffected either way -- this setting only governs
    // what happens on a non-match, not whether a MATCHING request still
    // bypasses the Worker (that's assets.run_worker_first, left at its
    // default/false, unchanged). src/worker.js now reproduces the old
    // "404-page" behavior itself for every path it doesn't redirect (both
    // the fuzzy-no-match case and the asset-like-bypass case) by explicitly
    // fetching /404.html through env.ASSETS and forcing a real 404 status
    // on the response -- see that file's serve404().
    "not_found_handling": "none"
  }
}
